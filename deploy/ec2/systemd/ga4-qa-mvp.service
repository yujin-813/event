[Unit]
Description=GA4 QA MVP Streamlit Service
After=network.target ga4-qa-xvfb.service
Wants=ga4-qa-xvfb.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ga4-qa-mvp
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99
Environment=USE_XVFB=0
ExecStart=/opt/ga4-qa-mvp/scripts/run.sh --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
