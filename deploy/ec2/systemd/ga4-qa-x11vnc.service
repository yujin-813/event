[Unit]
Description=GA4 QA x11vnc Bridge
After=ga4-qa-xvfb.service
Requires=ga4-qa-xvfb.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ga4-qa-mvp
Environment=XVFB_DISPLAY=:99
Environment=X11VNC_PORT=5900
ExecStart=/opt/ga4-qa-mvp/scripts/run_x11vnc.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
