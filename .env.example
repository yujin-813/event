# 현재 버전은 브라우저 레벨 이벤트 가로채기 전용입니다.
# 필수 환경변수는 없습니다.

# Analytics Proxy (옵션)
# 1이면 /qa/collect 저장 후 request_url로 업스트림 재전송 시도
# 주의: 브라우저가 이미 GA로 전송한 요청을 다시 보낼 수 있어 중복 전송 가능
QA_ANALYTICS_PROXY_ENABLED=0

# 0이면 Google Analytics 호스트만 포워딩 허용
QA_ANALYTICS_PROXY_ALLOW_ANY=0

# 업스트림 포워딩 timeout (초)
QA_ANALYTICS_PROXY_TIMEOUT_SEC=2.5

# 디버깅 시작 시 noVNC 팝업 자동 오픈 (EC2 권장)
QA_OPEN_NOVNC_ON_START=1

# noVNC 공개 URL (기본값: /vnc/vnc.html?autoconnect=1&resize=remote&path=vnc/websockify)
# QA_NOVNC_PUBLIC_URL=https://asknuggetdata.com/vnc/vnc.html?autoconnect=1&resize=remote&path=vnc/websockify

# UI 표시 시간대 (예: Asia/Seoul, UTC)
QA_DISPLAY_TZ=Asia/Seoul

# OAuth 리다이렉트 URI 강제 지정 (운영 환경 권장)
# GA4_OAUTH_REDIRECT_URI=https://asknuggetdata.com/oauth2callback

# 참고: client_secret.json 없이도 .streamlit/secrets.toml의 [auth.google]를 읽어 OAuth를 구성할 수 있습니다.
